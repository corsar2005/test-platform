SQLITE_DATABASE_PATH=test_platform.db
# NEON_DATABASE_URL имеет приоритет над DATABASE_URL и SQLite.
# Вставьте сюда URL PostgreSQL из Neon Console (не добавляйте его в Git):
# NEON_DATABASE_URL=
# DATABASE_URL имеет приоритет над SQLITE_DATABASE_PATH и задаёт URL любой СУБД:
# DATABASE_URL=sqlite:///C:/data/test_platform.db
